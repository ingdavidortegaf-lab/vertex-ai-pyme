        "cwd": "${workspaceFolder:0 - PROYECTO COMPLETO (para correr)}",
        "program": "lib/main.dart",
        "deviceId": "windows",
        "args": ["--dart-define-from-file=dart_defines.json"]
      },
      {
        "name": "▶ Correr en el PC sin nube (modo avión)",
        "type": "dart",
        "request": "launch",
        "cwd": "${workspaceFolder:0 - PROYECTO COMPLETO (para correr)}",
        "program": "lib/main.dart",
        "deviceId": "windows"
      },
      {
        "name": "▶ Correr en el celular (conectado por USB)",
        "type": "dart",
        "request": "launch",
        "cwd": "${workspaceFolder:0 - PROYECTO COMPLETO (para correr)}",
        "program": "lib/main.dart",
        "args": ["--dart-define-from-file=dart_defines.json"],
        "env": {
          "ANDROID_HOME": "C:\\Android\\sdk",
          "JAVA_TOOL_OPTIONS": "-Djavax.net.ssl.trustStore=C:\\Android\\java-truststore\\cacerts-avast.jks -Djavax.net.ssl.trustStorePassword=changeit"
