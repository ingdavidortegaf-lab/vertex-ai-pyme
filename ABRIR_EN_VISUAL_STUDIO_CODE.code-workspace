  "settings": {
    "dart.flutterSdkPath": "C:\\dev\\flutter",
    "dart.flutterHotReloadOnSave": "all",
    "files.encoding": "utf8",
    "workbench.startupEditor": "none",
    "explorer.compactFolders": false,
    "files.exclude": {
      "**/.dart_tool": true,
